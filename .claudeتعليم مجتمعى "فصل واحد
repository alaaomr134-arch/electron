# 3) ⚙️ ملف `app.js` (النظام كامل)

```javascript
let db;
let students = [];

/* =========================
   INIT STORAGE (IndexedDB)
========================= */

function initDB(){

let request = indexedDB.open("schoolDB",1);

request.onupgradeneeded = e=>{
db = e.target.result;
db.createObjectStore("students",{keyPath:"id",autoIncrement:true});
};

request.onsuccess = e=>{
db = e.target.result;
loadStudents();
};

}

/* =========================
   ADD STUDENT
========================= */

function addStudent(){

let s = {
name: name.value,
seat: seat.value,
national: national.value,
grade: grade.value,
term: term.value,

arabic:+arabic.value||0,
math:+math.value||0,
english:+english.value||0,
science:+science.value||0,
social:+social.value||0
};

s.total =
s.arabic +
s.math +
s.english +
s.science +
s.social;

let tx = db.transaction("students","readwrite");
tx.objectStore("students").add(s);

tx.oncomplete = ()=> loadStudents();

clearInputs();

}

/* =========================
   LOAD STUDENTS
========================= */

function loadStudents(){

let tx = db.transaction("students","readonly");
let store = tx.objectStore("students");

let req = store.getAll();

req.onsuccess = ()=>{

students = req.result;

let html = "";

students.forEach(s=>{

html += `
<tr>
<td>${s.name}</td>
<td>${s.seat}</td>
<td>${s.national}</td>
<td>${s.total}</td>
<td>
<button class="btn btn-danger btn-sm"
onclick="deleteStudent(${s.id})">حذف</button>
</td>
</tr>
`;

});

tbody.innerHTML = html;

};

}

/* =========================
   DELETE
========================= */

function deleteStudent(id){

let tx = db.transaction("students","readwrite");
tx.objectStore("students").delete(id);

tx.oncomplete = loadStudents;

}

/* =========================
   CLEAR
========================= */

function clearInputs(){

name.value="";
seat.value="";
national.value="";
arabic.value="";
math.value="";
english.value="";
science.value="";
social.value="";

}

/* =========================
   PRINT
========================= */

function printTable(){

let win = window.open("");

win.document.write(`
<html dir="rtl">
<head>
<title>طباعة</title>
<style>
table{width:100%;border-collapse:collapse}
td,th{border:2px solid #000;padding:5px;text-align:center}
</style>
</head>
<body>

<h3 style="text-align:center">
مديرية التربية والتعليم
</h3>

${document.querySelector("table").outerHTML}

</body>
</html>
`);

win.print();

}

/* =========================
   EXCEL
========================= */

function exportExcel(){

let ws = XLSX.utils.json_to_sheet(students);

let wb = XLSX.utils.book_new();

XLSX.utils.book_append_sheet(wb,ws,"Students");

XLSX.writeFile(wb,"students.xlsx");

}

/* =========================
   PDF
========================= */

function exportPDF(){

const { jsPDF } = window.jspdf;

let doc = new jsPDF();

doc.text("Students Report",10,10);

let y = 20;

students.forEach(s=>{

doc.text(`${s.name} - ${s.total}`,10,y);

y += 10;

});

doc.save("report.pdf");

}

/* =========================
   START
========================= */

initDB();
```

